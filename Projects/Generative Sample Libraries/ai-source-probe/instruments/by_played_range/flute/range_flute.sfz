// range · flute — built from the AI-source probe's graded run
// source: ai-source-probe/results.range.jsonl  ·  builder: build_sfz.py
// filed by the key each take played, not the note it was asked for
// probe verdict for this instrument: TEXTURE ONLY  (on target 7, retunable 25, texture 18, of 50 cells)
// 24 of 25 notes asked for had a steady take (best of 2 takes)
// kept 11 of 25 notes asked for; no steady render of G1; E1, A#1, C#2, G2, C#3, E3, A#3, C#4, G4, A#4, E5, A#5, E6 sounded on keys already taken
// keys E2–C#7; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E2, seed 1, retunable, +1183.8c from asked
<region> sample=flute_E2_s1.wav lokey=40 hikey=53 pitch_keycenter=52 tune=16 offset=0
// asked G3, seed 1, on target, -7.8c from asked
<region> sample=flute_G3_s1.wav lokey=54 hikey=56 pitch_keycenter=55 tune=8 offset=0
