// musicgen_melody · violin — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_melody.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: RETUNABLE  (on target 0, retunable 6, texture 2, of 8 cells)
// kept 3 of 4 notes asked for; no steady render of G5
// keys A2–E5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked A2, seed 1, retunable, +1198.4c from asked
<region> sample=violin_A2_s1.wav lokey=45 hikey=58 pitch_keycenter=57 tune=2 offset=0
// asked C4, seed 2, retunable, -30.0c from asked
<region> sample=violin_C4_s2.wav lokey=59 hikey=62 pitch_keycenter=60 tune=30 offset=0
// asked E3, seed 2, retunable, +1183.8c from asked
<region> sample=violin_E3_s2.wav lokey=63 hikey=76 pitch_keycenter=64 tune=16 offset=0
