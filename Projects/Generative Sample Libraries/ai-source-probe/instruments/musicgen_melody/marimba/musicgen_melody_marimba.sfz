// musicgen_melody · marimba — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_melody.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: RETUNABLE  (on target 3, retunable 3, texture 2, of 8 cells)
// kept 4 of 4 notes asked for
// keys E2–C5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, +12.6c from asked
<region> sample=marimba_E3_s2.wav lokey=40 hikey=53 pitch_keycenter=52 tune=-13 offset=0
// asked G5, seed 1, retunable, -2383.8c from asked
<region> sample=marimba_G5_s1.wav lokey=54 hikey=56 pitch_keycenter=55 tune=-16 offset=0
// asked A2, seed 1, retunable, +1208.4c from asked
<region> sample=marimba_A2_s1.wav lokey=57 hikey=58 pitch_keycenter=57 tune=-8 offset=0
// asked C4, seed 2, on target, +19.7c from asked
<region> sample=marimba_C4_s2.wav lokey=59 hikey=72 pitch_keycenter=60 tune=-20 offset=0
