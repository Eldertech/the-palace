// musicgen_melody · choir — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_melody.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 1, retunable 4, texture 3, of 8 cells)
// kept 3 of 4 notes asked for; no steady render of G5
// keys E2–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, -10.2c from asked
<region> sample=choir_E3_s2.wav lokey=40 hikey=54 pitch_keycenter=52 tune=10 offset=0
// asked A2, seed 1, retunable, +1200.4c from asked
<region> sample=choir_A2_s1.wav lokey=55 hikey=64 pitch_keycenter=57 tune=0 offset=0
// asked C4, seed 2, retunable, +1199.6c from asked
<region> sample=choir_C4_s2.wav lokey=65 hikey=84 pitch_keycenter=72 tune=0 offset=0
