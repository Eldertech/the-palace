// musicgen_melody · flute — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_melody.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 0, retunable 5, texture 3, of 8 cells)
// kept 3 of 4 notes asked for; no steady render of A2
// keys E3–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 1, retunable, +1202.0c from asked
<region> sample=flute_E3_s1.wav lokey=52 hikey=65 pitch_keycenter=64 tune=-2 offset=0
// asked G5, seed 2, retunable, -1210.7c from asked
<region> sample=flute_G5_s2.wav lokey=66 hikey=69 pitch_keycenter=67 tune=11 offset=0
// asked C4, seed 1, retunable, +1190.5c from asked
<region> sample=flute_C4_s1.wav lokey=70 hikey=84 pitch_keycenter=72 tune=9 offset=0
