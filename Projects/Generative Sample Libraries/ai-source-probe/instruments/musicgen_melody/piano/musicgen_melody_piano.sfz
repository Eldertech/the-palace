// musicgen_melody · piano — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_melody.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 1, retunable 2, texture 5, of 8 cells)
// kept 2 of 4 notes asked for; no steady render of A2, G5
// keys E2–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, +0.3c from asked
<region> sample=piano_E3_s2.wav lokey=40 hikey=62 pitch_keycenter=52 tune=0 offset=0
// asked C4, seed 2, retunable, +1201.5c from asked
<region> sample=piano_C4_s2.wav lokey=63 hikey=84 pitch_keycenter=72 tune=-2 offset=0
