// stable_audio · flute — built from the AI-source probe's graded run
// source: ai-source-probe/results.stable_audio.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 0, retunable 3, texture 5, of 8 cells)
// kept 2 of 4 notes asked for; no steady render of E3, G5
// keys A2–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked A2, seed 1, retunable, +1205.4c from asked
<region> sample=flute_A2_s1.wav lokey=45 hikey=64 pitch_keycenter=57 tune=-5 offset=1150
// asked C4, seed 2, retunable, +1213.5c from asked
<region> sample=flute_C4_s2.wav lokey=65 hikey=84 pitch_keycenter=72 tune=-14 offset=0
