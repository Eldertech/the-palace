// stable_audio · bass — built from the AI-source probe's graded run
// source: ai-source-probe/results.stable_audio.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 0, retunable 1, texture 7, of 8 cells)
// kept 1 of 4 notes asked for; no steady render of A2, E3, C4
// keys G2–G4; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked G5, seed 1, retunable, -2400.0c from asked
<region> sample=bass_G5_s1.wav lokey=43 hikey=67 pitch_keycenter=55 tune=0 offset=0
