// mgm_pool · piano — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 2, retunable 7, texture 31, of 40 cells)
// kept 4 of 4 notes asked for
// keys E2–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, +0.3c from asked
<region> sample=piano_E3_s2.wav lokey=40 hikey=54 pitch_keycenter=52 tune=0 offset=0
// asked A2, seed 1, retunable, +1202.3c from asked
<region> sample=piano_A2_s1.wav lokey=55 hikey=62 pitch_keycenter=57 tune=-2 offset=0
// asked G5, seed 2, retunable, -1207.4c from asked
<region> sample=piano_G5_s2.wav lokey=63 hikey=69 pitch_keycenter=67 tune=7 offset=0
// asked C4, seed 2, retunable, +1197.9c from asked
<region> sample=piano_C4_s2.wav lokey=70 hikey=84 pitch_keycenter=72 tune=2 offset=0
