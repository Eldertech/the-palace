// mgm_pool · violin — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 0, retunable 25, texture 15, of 40 cells)
// kept 4 of 4 notes asked for
// keys A2–G5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked A2, seed 2, retunable, +1199.8c from asked
<region> sample=violin_A2_s2.wav lokey=45 hikey=58 pitch_keycenter=57 tune=0 offset=0
// asked C4, seed 2, retunable, -30.0c from asked
<region> sample=violin_C4_s2.wav lokey=59 hikey=62 pitch_keycenter=60 tune=30 offset=0
// asked E3, seed 1, retunable, +1198.7c from asked
<region> sample=violin_E3_s1.wav lokey=63 hikey=65 pitch_keycenter=64 tune=1 offset=0
// asked G5, seed 1, retunable, -1207.5c from asked
<region> sample=violin_G5_s1.wav lokey=66 hikey=79 pitch_keycenter=67 tune=7 offset=0
