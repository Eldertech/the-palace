// mgm_pool · bass — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 3, retunable 14, texture 23, of 40 cells)
// kept 4 of 4 notes asked for
// keys E2–G5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, -0.3c from asked
<region> sample=bass_E3_s2.wav lokey=40 hikey=54 pitch_keycenter=52 tune=0 offset=0
// asked A2, seed 2, retunable, +1203.3c from asked
<region> sample=bass_A2_s2.wav lokey=55 hikey=58 pitch_keycenter=57 tune=-3 offset=0
// asked C4, seed 2, retunable, +26.0c from asked
<region> sample=bass_C4_s2.wav lokey=59 hikey=63 pitch_keycenter=60 tune=-26 offset=37650
// asked G5, seed 2, retunable, -1195.2c from asked
<region> sample=bass_G5_s2.wav lokey=64 hikey=79 pitch_keycenter=67 tune=-5 offset=0
