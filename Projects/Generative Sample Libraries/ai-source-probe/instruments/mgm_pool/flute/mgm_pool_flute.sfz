// mgm_pool · flute — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 5, retunable 17, texture 18, of 40 cells)
// kept 4 of 4 notes asked for
// keys E2–G6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 1, on target, +3.3c from asked
<region> sample=flute_E3_s1.wav lokey=40 hikey=54 pitch_keycenter=52 tune=-3 offset=0
// asked A2, seed 2, retunable, +1211.9c from asked
<region> sample=flute_A2_s2.wav lokey=55 hikey=58 pitch_keycenter=57 tune=-12 offset=0
// asked C4, seed 1, on target, +14.7c from asked
<region> sample=flute_C4_s1.wav lokey=59 hikey=69 pitch_keycenter=60 tune=-15 offset=2133
// asked G5, seed 2, on target, -0.7c from asked
<region> sample=flute_G5_s2.wav lokey=70 hikey=91 pitch_keycenter=79 tune=1 offset=0
