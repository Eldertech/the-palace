// mgm_pool · choir — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 10, retunable 14, texture 16, of 40 cells)
// kept 3 of 4 notes asked for; no steady render of G5
// keys A1–C5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked A2, seed 2, on target, -4.8c from asked
<region> sample=choir_A2_s2.wav lokey=33 hikey=48 pitch_keycenter=45 tune=5 offset=0
// asked E3, seed 1, on target, -8.0c from asked
<region> sample=choir_E3_s1.wav lokey=49 hikey=56 pitch_keycenter=52 tune=8 offset=0
// asked C4, seed 1, on target, +0.4c from asked
<region> sample=choir_C4_s1.wav lokey=57 hikey=72 pitch_keycenter=60 tune=0 offset=0
