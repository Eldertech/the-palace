// mgm_pool · marimba — built from the AI-source probe's graded run
// source: ai-source-probe/results.mgm_pool.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: TEXTURE ONLY  (on target 10, retunable 14, texture 16, of 40 cells)
// kept 4 of 4 notes asked for
// keys E2–G5; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked E3, seed 2, on target, +11.6c from asked
<region> sample=marimba_E3_s2.wav lokey=40 hikey=54 pitch_keycenter=52 tune=-12 offset=0
// asked A2, seed 1, retunable, +1208.4c from asked
<region> sample=marimba_A2_s1.wav lokey=55 hikey=58 pitch_keycenter=57 tune=-8 offset=0
// asked C4, seed 1, on target, +13.0c from asked
<region> sample=marimba_C4_s1.wav lokey=59 hikey=63 pitch_keycenter=60 tune=-13 offset=0
// asked G5, seed 2, retunable, -1198.3c from asked
<region> sample=marimba_G5_s2.wav lokey=64 hikey=79 pitch_keycenter=67 tune=-2 offset=0
