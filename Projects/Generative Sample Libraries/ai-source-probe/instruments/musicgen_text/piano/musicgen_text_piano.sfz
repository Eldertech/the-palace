// musicgen_text · piano — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_text.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: RETUNABLE  (on target 0, retunable 6, texture 2, of 8 cells)
// kept 3 of 4 notes asked for; no steady render of E3
// keys F1–C6; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked A2, seed 1, retunable, -397.6c from asked
<region> sample=piano_A2_s1.wav lokey=29 hikey=50 pitch_keycenter=41 tune=-2 offset=0
// asked G5, seed 2, retunable, -1899.4c from asked
<region> sample=piano_G5_s2.wav lokey=51 hikey=66 pitch_keycenter=60 tune=-1 offset=0
// asked C4, seed 2, retunable, +1201.5c from asked
<region> sample=piano_C4_s2.wav lokey=67 hikey=84 pitch_keycenter=72 tune=-2 offset=0
