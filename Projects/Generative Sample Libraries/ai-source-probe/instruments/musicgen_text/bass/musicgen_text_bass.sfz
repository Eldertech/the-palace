// musicgen_text · bass — built from the AI-source probe's graded run
// source: ai-source-probe/results.musicgen_text.jsonl  ·  builder: build_sfz.py
// probe verdict for this instrument: RETUNABLE  (on target 0, retunable 7, texture 1, of 8 cells)
// kept 2 of 4 notes asked for; no steady render of A2, E3
// keys C3–C7; outer samples stretch at most 12 semitones; no silent gaps
// pitch = the grader's measured pitch (keycenter + tune), not the note asked for.
// onset trim -30 dBFS, 2 ms cushion; 3 ms fade-in.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.003 ampeg_release=0.4

<group>
// asked C4, seed 1, retunable, -30.0c from asked
<region> sample=bass_C4_s1.wav lokey=48 hikey=72 pitch_keycenter=60 tune=30 offset=0
// asked G5, seed 2, retunable, +518.5c from asked
<region> sample=bass_G5_s2.wav lokey=73 hikey=96 pitch_keycenter=84 tune=-18 offset=0
