// range+violin_bo5_violin_shaped — attacks reshaped from range+violin_bo5_violin.sfz by shape_attacks.py --mode bow
// model's first stroke cut away; the sampler bows the note on (140 ms soft, 40 ms full velocity)
// zones and keycenters are the source's; tune is re-measured on each reshaped sample.

<control>
default_path=samples/

<global>
loop_mode=no_loop
pitch_keytrack=100
ampeg_attack=0.14 ampeg_vel2attack=-0.1 ampeg_release=0.35

<group>
// cut in at 0.151 s (model opened at -5.8 dB, sustain -5.1 dB)
<region> sample=range__violin_E5_s2.wav lokey=40 hikey=53 pitch_keycenter=52 tune=2 offset=0
// cut in at 0.15 s (model opened at -9.5 dB, sustain -6.8 dB)
<region> sample=violin_bo5__violin_G5_s4.wav lokey=54 hikey=56 pitch_keycenter=55 tune=0 offset=0
// cut in at 0.15 s (model opened at -4.8 dB, sustain -4.9 dB)
<region> sample=range__violin_A#4_s2.wav lokey=57 hikey=59 pitch_keycenter=58 tune=6 offset=0
// cut in at 0.15 s (model opened at -2.9 dB, sustain -3.5 dB)
<region> sample=range__violin_C#5_s1.wav lokey=60 hikey=62 pitch_keycenter=61 tune=-9 offset=0
// cut in at 0.231 s (model opened at -15.1 dB, sustain -8.2 dB)
<region> sample=violin_bo5__violin_E4_s4.wav lokey=63 hikey=65 pitch_keycenter=64 tune=-1 offset=0
// cut in at 0.15 s (model opened at -8.0 dB, sustain -5.4 dB)
<region> sample=violin_bo5__violin_G3_s5.wav lokey=66 hikey=68 pitch_keycenter=67 tune=2 offset=0
// cut in at 0.151 s (model opened at -5.9 dB, sustain -2.9 dB)
<region> sample=violin_bo5__violin_A#3_s4.wav lokey=69 hikey=71 pitch_keycenter=70 tune=-1 offset=0
// cut in at 0.3 s (model opened at -10.9 dB, sustain -3.3 dB)
<region> sample=violin_bo5__violin_C#4_s5.wav lokey=72 hikey=74 pitch_keycenter=73 tune=-1 offset=0
// cut in at 0.151 s (model opened at -6.3 dB, sustain -4.2 dB)
<region> sample=violin_bo5__violin_E4_s5.wav lokey=75 hikey=77 pitch_keycenter=76 tune=0 offset=0
// cut in at 0.21 s (model opened at -10.0 dB, sustain -3.0 dB)
<region> sample=violin_bo5__violin_G5_s5.wav lokey=78 hikey=80 pitch_keycenter=79 tune=-7 offset=0
// cut in at 0.15 s (model opened at -7.8 dB, sustain -6.3 dB)
<region> sample=violin_bo5__violin_A#4_s3.wav lokey=81 hikey=94 pitch_keycenter=82 tune=-7 offset=0
