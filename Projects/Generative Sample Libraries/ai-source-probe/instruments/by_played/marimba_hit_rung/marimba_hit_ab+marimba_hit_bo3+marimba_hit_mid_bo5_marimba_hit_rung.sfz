// marimba_hit_ab+marimba_hit_bo3+marimba_hit_mid_bo5_marimba_hit_rung — attacks reshaped from marimba_hit_ab+marimba_hit_bo3+marimba_hit_mid_bo5_marimba_hit.sfz by shape_attacks.py --mode ring
// one strike kept per sample: the one that rang longest before the model struck again
// then rung out: the strike's own partials fitted just before the model's next hit, each left to decay (lowest slowest)
// zones and keycenters are the source's; tune is re-measured on each reshaped sample.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=100
ampeg_attack=0.001 ampeg_release=0.3

<group>
