// Crystal Instrument — Phase 3 of Generative Sample Libraries
// First non-Kokoro source: Hexagonal (Quartz) from Crystal Audio/crystal_synth.py
// 4 notes (C2,C3,C4,C5) x 2 velocity layers = 8 regions (AUDITION UNIT).
//
// Pitch: base_freq set per MIDI note; FREQ_ANCHOR='lowest_mode' anchors
// the lowest phonon at base_freq, and a quiet strike tone (adapter-level)
// makes that the perceived pitch. pitch_keytrack=0: each region plays its
// own pre-pitched sample.
// Onset trim: -30 dBFS, -1 ms cushion. Fade-in: 3 ms.

<control>
default_path=samples/

<global>
loop_mode=one_shot
pitch_keytrack=0
ampeg_attack=0.003 ampeg_release=0.1
amp_veltrack=0

// Layer 1 (vel 1-63): soft strike (long shimmer)
<group>
  lovel=1 hivel=63
<region> sample=crystal_C2_L1.wav lokey=36 hikey=36 pitch_keycenter=36 offset=44
<region> sample=crystal_C3_L1.wav lokey=48 hikey=48 pitch_keycenter=48 offset=44
<region> sample=crystal_C4_L1.wav lokey=60 hikey=60 pitch_keycenter=60 offset=44
<region> sample=crystal_C5_L1.wav lokey=72 hikey=72 pitch_keycenter=72 offset=44

// Layer 2 (vel 64-127): hard strike (sharper, drier)
<group>
  lovel=64 hivel=127
<region> sample=crystal_C2_L2.wav lokey=36 hikey=36 pitch_keycenter=36 offset=44
<region> sample=crystal_C3_L2.wav lokey=48 hikey=48 pitch_keycenter=48 offset=44
<region> sample=crystal_C4_L2.wav lokey=60 hikey=60 pitch_keycenter=60 offset=44
<region> sample=crystal_C5_L2.wav lokey=72 hikey=72 pitch_keycenter=72 offset=44

