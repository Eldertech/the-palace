{
  "_comment": "BLUELINE M3 — FLUX-ControlNet-OpenPose with EXTERNAL noise injection. Identical to flux-controlnet-openpose.workflow.json except the seed-based KSampler is replaced by the SamplerCustomAdvanced chain (NoiseFromNPY -> BasicGuider/KSamplerSelect/BasicScheduler) so the initial latent noise is N_A (seed-lock) or N_warped (flow-warped). The runner (m3_pod_render.py) fills <PROMPT>, <POSE_IMAGE>, and supplies the noise either as the on-pod path here or, by default, base64-inline via the node's b64 input (no file transfer). Render params (guidance 3.5, cn strength 0.75, end 0.85, euler/simple, 24 steps, 832x1216) match the proven Track I Phase B render.",
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "flux1-dev-fp8.safetensors" }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "<PROMPT>", "clip": ["ckpt", 1] }
  },
  "flux": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["pos", 0], "guidance": 3.5 }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["ckpt", 1] }
  },
  "cnet": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "flux-union-pro.safetensors" }
  },
  "union": {
    "class_type": "SetUnionControlNetType",
    "inputs": { "control_net": ["cnet", 0], "type": "openpose" }
  },
  "pose": {
    "class_type": "LoadImage",
    "inputs": { "image": "<POSE_IMAGE>.png" }
  },
  "apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["flux", 0],
      "negative": ["neg", 0],
      "control_net": ["union", 0],
      "image": ["pose", 0],
      "strength": 0.75,
      "start_percent": 0.0,
      "end_percent": 0.85,
      "vae": ["ckpt", 2]
    }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 832, "height": 1216, "batch_size": 1 }
  },
  "noise": {
    "class_type": "NoiseFromNPY",
    "inputs": { "path": "<NOISE_PATH>", "seed": 0, "b64": "" }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["ckpt", 0], "conditioning": ["apply", 0] }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["ckpt", 0], "scheduler": "simple", "steps": 24, "denoise": 1.0 }
  },
  "samp": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["latent", 0]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["samp", 0], "vae": ["ckpt", 2] }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "m3frame", "images": ["dec", 0] }
  }
}
