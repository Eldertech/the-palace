<region> sample=hihat_E2_L2.wav        lokey=40 hikey=40 pitch_keycenter=40
<region> sample=hihat_F2_L2.wav        lokey=41 hikey=41 pitch_keycenter=41
<region> sample=hihat_F#2_L2.wav       lokey=42 hikey=42 pitch_keycenter=42
<region> sample=hihat_G2_L2.wav        lokey=43 hikey=43 pitch_keycenter=43
<region> sample=hihat_G#2_L2.wav       lokey=44 hikey=44 pitch_keycenter=44
<region> sample=hihat_A2_L2.wav        lokey=45 hikey=45 pitch_keycenter=45
<region> sample=hihat_A#2_L2.wav       lokey=46 hikey=46 pitch_keycenter=46
