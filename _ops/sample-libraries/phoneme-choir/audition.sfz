// Phoneme Choir AUDITION — MIDI 56 (G#3) = 'knock', 4 velocity layers
// Drag into sforzando, hammer G#3 at varying velocities.
// Onset trim: -30 dBFS threshold, 1 ms forward into sound. Fade-in: 3 ms.
<group>
  ampeg_attack=0.003 ampeg_release=0.05

