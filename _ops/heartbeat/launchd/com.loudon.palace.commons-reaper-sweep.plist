<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.loudon.palace.commons-reaper-sweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>/Users/loudonstearns/Documents/The Palace/_ops/heartbeat/run-commons-reaper-sweep.sh</string>
  </array>

  <!-- Daily 07:00 local. Report-only: FLAGs suspected leaked resources, terminates nothing. -->
