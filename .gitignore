.DS_Store
.claude/worktrees/

# Obsidian cache and workspace state (ephemeral)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph-cache

# Python bytecode
__pycache__/
*.pyc

# Manim render cache (regenerable from source .py + Manim version)
_manim_media/
**/_manim_media/

# Per-Specialist venvs (Kokoro, Whisper, etc. live in .venvs/<specialist>/)
.venvs/

# Enrichment server / worker runtime artifacts (logs, PIDs, started markers)
Enrichment/.server.log
Enrichment/.server.pid
Enrichment/.worker.log
Enrichment/.worker.started

# Test-touch / scratch markers
.claude/agents-test-touch
