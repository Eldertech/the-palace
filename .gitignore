.DS_Store
.claude/worktrees/

# Obsidian cache and workspace state (ephemeral)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph-cache

# Python bytecode
__pycache__/
*.pyc

# Manim render cache (regenerable from source .py + Manim version)
_manim_media/
**/_manim_media/

# ffmpeg pipeline intermediates inside bundles (regenerable from the .py)
**/_*.mp4
**/_*.png

# Per-Specialist venvs (Kokoro, Whisper, etc. live in .venvs/<specialist>/)
.venvs

# External tool checkouts (ComfyUI source, model weights, etc.)
# Slash-less so a `_tools` / `.venvs` SYMLINK in a git worktree is ignored too, not just
# the real directory in the owner checkout (see _ops/worktree/). The real dir stays ignored.
_tools

# Remotion project node_modules + Remotion build cache (regenerable via `npm install`)
**/node_modules
**/.remotion/

# Enrichment server / worker runtime artifacts (logs, PIDs, started markers)
Enrichment/.server.log
Enrichment/.server.pid
Enrichment/.worker.log
Enrichment/.worker.started

# Test-touch / scratch markers
.claude/agents-test-touch

# Vitest config timestamp temp files (transient)
**/vitest.config.js.timestamp-*.mjs
# Cowork scratch — relocated junk Cowork couldn't delete (not knowledge)
_ops/scratch/
# Cowork local settings
.claude/settings.local.json

# Generated audio renders inside generative-instrument bundles
# (heavy + regenerable from the bundle's generate.py — commit the recipe, not the bytes)
Projects/Generative Wavetable Libraries/**/*.wav
Projects/Generative Sample Libraries/**/*.wav

# Ableton analysis files (regenerated when a WAV is loaded)
*.asd

**/vite.config.js.timestamp-*.mjs

# Vite dependency pre-bundle cache (regenerable on next dev/build)
.vite/
**/.vite/

# STIGMERGY actuator runtime state (the fired-worker pid/log/started files)
_ops/stigmergy/.actuator/
# STIGMERGY steward lane runtime state (pid/log + per-cycle transcripts + last-cycle)
_ops/stigmergy/.actuator-steward/
# STIGMERGY companion actuator runtime state (pid/log + per-cycle transcripts)
_ops/stigmergy/.actuator-companion/

# Atomic-write temp files (state.json.tmp etc. — transient write-then-rename
# intermediates left behind if a write is interrupted; never knowledge)
**/*.json.tmp

# Figure Rig examples — raw gen batch (reproducible; embedded in figure_rig_proofs.html)
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*/gen_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*/verify_strip.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/mpfb-v3/pose_B_male/redraw_male.log

# Figure Rig hands — raw gen batch (reproducible; in figure_rig_hands.html + contact sheets)
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands-gen/*/gen_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands-gen/*.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands/plates.log
